# ---- Primary LLM (recommended: see README section "LLM selection") ----
LLM_PROVIDER=openai            # openai | anthropic | gemini
LLM_MODEL=gpt-6-luna           # anthropic: claude-haiku-5-5 | gemini: check ai.google.dev for the current Flash model id

# Put ONLY the key for the provider(s) you use. Never commit your real .env file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- Optional fallback (used only if the primary provider fails after retries) ----
FALLBACK_PROVIDER=
FALLBACK_MODEL=

# ---- Optional: report estimated cost per request (USD per 1M tokens) ----
# Values below match gpt-6-luna and claude-haiku-5-5 list prices (prompts <= 100K tokens).
LLM_INPUT_PRICE_PER_M=0.10
LLM_OUTPUT_PRICE_PER_M=0.50

# ---- Tuning (defaults are fine) ----
# MAX_CONTENT_CHARS=12000
# MAX_EXTRA_PAGES=2
# CACHE_TTL_SECONDS=3600
